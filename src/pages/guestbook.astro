---
import Layout from '../layouts/Layout.astro';
---

<Layout title="留言" description="欢迎留言交流">
  <div class="mx-auto max-w-3xl px-6 pt-28 pb-24">
    <div class="mb-12">
      <h1 class="text-3xl font-bold text-text-main tracking-tight">留言板</h1>
      <p class="mt-2 text-text-sub">欢迎在这里留下你的想法、建议或问题</p>
    </div>

    <!-- Netlify Forms 留言表单 -->
    <form
      name="guestbook"
      method="POST"
      netlify
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="glass-card rounded-lg p-8"
    >
      <!-- Honeypot 防爬虫 -->
      <p class="hidden">
        <label>
          不要填写此框: <input name="bot-field" />
        </label>
      </p>

      <input type="hidden" name="form-name" value="guestbook" />

      <div class="space-y-5">
        <!-- 昵称 -->
        <div>
          <label for="name" class="block text-sm font-medium text-text-main mb-1.5">昵称</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="你的名字"
            class="w-full rounded-default border border-primary/15 bg-bg-main px-4 py-2.5 text-sm text-text-main placeholder:text-text-sub/30 outline-none focus:border-primary/40 focus:ring-1 focus:ring-primary/20 transition-all duration-200"
          />
        </div>

        <!-- 邮箱 -->
        <div>
          <label for="email" class="block text-sm font-medium text-text-main mb-1.5">邮箱 (不会被公开)</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="your@email.com"
            class="w-full rounded-default border border-primary/15 bg-bg-main px-4 py-2.5 text-sm text-text-main placeholder:text-text-sub/30 outline-none focus:border-primary/40 focus:ring-1 focus:ring-primary/20 transition-all duration-200"
          />
        </div>

        <!-- 内容 -->
        <div>
          <label for="message" class="block text-sm font-medium text-text-main mb-1.5">留言内容</label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            placeholder="写下你想说的话…"
            class="w-full rounded-default border border-primary/15 bg-bg-main px-4 py-2.5 text-sm text-text-main placeholder:text-text-sub/30 outline-none focus:border-primary/40 focus:ring-1 focus:ring-primary/20 transition-all duration-200 resize-y"
          ></textarea>
        </div>

        <!-- 提交按钮 -->
        <button
          type="submit"
          class="inline-flex items-center gap-2 rounded-default bg-primary px-6 py-2.5 text-sm font-medium text-white hover:bg-primary/90 transition-all duration-250 shadow-soft"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          发送留言
        </button>
      </div>

      <p class="mt-6 text-xs text-text-sub/40 leading-relaxed">
        提交即表示你同意留言内容在页面上公开显示。邮箱仅用于管理员回复，不会公开。
      </p>
    </form>

    <!-- 留言列表占位（Netlify Forms 需要在后台查看） -->
    <div class="mt-12">
      <h2 class="text-lg font-semibold text-text-main mb-6">近期留言</h2>
      <div class="glass-card rounded-lg p-8 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-text-sub/30 mb-3"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <p class="text-sm text-text-sub/50">还没有留言，来做第一个留言的人吧！</p>
      </div>
    </div>
  </div>
</Layout>