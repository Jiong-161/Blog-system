---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getAllTags } from '../lib/utils';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const tags = getAllTags(allPosts);
const totalWordCount = 0; // placeholder: real word count would need full content
const oldest = allPosts.reduce((oldest, p) =>
  new Date(p.data.pubDate) < new Date(oldest.data.pubDate) ? p : oldest,
);
const categories = [...new Set(allPosts.map((p) => p.data.category))];
---

<Layout title="关于" description="关于 Morandi Tech Blog 和作者">
  <div class="mx-auto max-w-4xl px-6 pt-28 pb-24">
    <!-- 头像区域 -->
    <div class="flex flex-col items-center mb-16">
      <div class="w-24 h-24 rounded-full bg-gradient-to-br from-primary/30 via-secondary to-accent-pink/30 flex items-center justify-center text-3xl font-bold text-primary shadow-soft-md">
        M
      </div>
      <h1 class="mt-6 text-3xl font-bold text-text-main tracking-tight">Morandi Tech Blog</h1>
      <p class="mt-2 text-text-sub max-w-md text-center leading-relaxed">
        在代码与美学之间寻找平衡。关于前端工程、设计系统与深度思考的个人笔记。
      </p>
    </div>

    <!-- 博客统计卡片 -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
      <div class="rounded-default bg-secondary/40 p-5 shadow-soft border border-primary/5 text-center">
        <p class="text-2xl font-bold text-primary">{allPosts.length}</p>
        <p class="text-xs text-text-sub/60 mt-1">文章总数</p>
      </div>
      <div class="rounded-default bg-secondary/40 p-5 shadow-soft border border-primary/5 text-center">
        <p class="text-2xl font-bold text-accent-green">{tags.length}</p>
        <p class="text-xs text-text-sub/60 mt-1">标签数量</p>
      </div>
      <div class="rounded-default bg-secondary/40 p-5 shadow-soft border border-primary/5 text-center">
        <p class="text-2xl font-bold text-accent-pink">{categories.length}</p>
        <p class="text-xs text-text-sub/60 mt-1">分类数量</p>
      </div>
      <div class="rounded-default bg-secondary/40 p-5 shadow-soft border border-primary/5 text-center">
        <p class="text-2xl font-bold text-primary">{new Date(oldest.data.pubDate).getFullYear()}</p>
        <p class="text-xs text-text-sub/60 mt-1">起始年份</p>
      </div>
    </div>

    <!-- 时间线简历 -->
    <section class="mb-16">
      <h2 class="text-xl font-bold text-text-main mb-6 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        历程
      </h2>
      <div class="relative pl-8 border-l-2 border-primary/10 space-y-8">
        <div class="relative">
          <div class="absolute -left-[calc(2rem+5px)] top-1 w-3 h-3 rounded-full bg-primary"></div>
          <p class="text-sm font-semibold text-text-main">2026 · 博客重建</p>
          <p class="text-sm text-text-sub mt-1">使用 Astro 7 + Tailwind v4 重建博客，采用莫兰迪治愈美学设计系统。</p>
        </div>
        <div class="relative">
          <div class="absolute -left-[calc(2rem+5px)] top-1 w-3 h-3 rounded-full bg-accent-green"></div>
          <p class="text-sm font-semibold text-text-main">2025 · 开源项目</p>
          <p class="text-sm text-text-sub mt-1">发布了多个前端工具库，累计获得 2k+ Star。</p>
        </div>
        <div class="relative">
          <div class="absolute -left-[calc(2rem+5px)] top-1 w-3 h-3 rounded-full bg-accent-pink"></div>
          <p class="text-sm font-semibold text-text-main">2024 · 技术写作开始</p>
          <p class="text-sm text-text-sub mt-1">开始系统性地撰写前端工程化与设计系统相关的技术文章。</p>
        </div>
      </div>
    </section>

    <!-- 技术栈标签云 -->
    <section>
      <h2 class="text-xl font-bold text-text-main mb-6 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        技术栈
      </h2>
      <div class="flex flex-wrap gap-3">
        {['React', 'Vue', 'TypeScript', 'Astro', 'Tailwind CSS', 'Node.js', 'PostgreSQL', 'Docker', 'GitHub Actions', 'Netlify', 'Figma', 'Vite'].map((tech) => (
          <span class="inline-block rounded-full px-4 py-1.5 text-sm font-medium bg-primary/8 text-text-sub hover:bg-primary/15 hover:text-primary transition-all duration-200 cursor-default">
            {tech}
          </span>
        ))}
      </div>
    </section>

    <!-- 文章标签云 -->
    {tags.length > 0 && (
      <section class="mt-16">
        <h2 class="text-xl font-bold text-text-main mb-6 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          文章标签
        </h2>
        <div class="flex flex-wrap gap-3">
          {tags.map((tag) => (
            <a
              href={'/blog?tag=' + encodeURIComponent(tag.name)}
              class="inline-block rounded-full px-4 py-1.5 text-sm font-medium text-text-sub hover:text-primary hover:bg-primary/10 transition-all duration-200"
            >
              #{tag.name} ({tag.count})
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>