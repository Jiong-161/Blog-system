---
import Layout from "../layouts/Layout.astro";
import BlogCard from "../components/BlogCard.astro";
import { getCollection } from "astro:content";
import heroBg from "../assets/a1.jpg";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);
const recentPosts = sortedPosts.slice(0, 4);
---

<Layout title="首页">
  <!-- ===== HERO: Opening Animation ===== -->
  <section class="relative h-screen w-full overflow-hidden">
    <!-- Background with slow zoom -->
    <div class="absolute inset-0 bg-cover bg-center anim-hero-zoom" style={{ backgroundImage: `url(${heroBg.src})` }}></div>

    <!-- Dark overlay that fades in -->
    <div class="absolute inset-0 bg-black/30"></div>

    <!-- Subtle gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-black/20"></div>

    <!-- Content -->
    <div class="relative z-10 flex h-full flex-col items-center justify-center px-6">
      <!-- Decorative top line -->
      <div class="w-16 h-px bg-white/40 anim-line-draw mb-8"></div>

      <!-- Main title: Compress + Spring -->
      <h1 class="anim-compress-spring text-6xl md:text-8xl font-bold tracking-tight text-white text-center leading-[1.05]">
        Morandi<br/>
        <span class="font-light italic tracking-wide text-white/70 text-4xl md:text-5xl">Tech</span>
        <span class="block text-2xl md:text-3xl font-light tracking-[0.3em] text-white/40 mt-4">BLOG</span>
      </h1>

      <!-- Decorative bottom line -->
      <div class="w-24 h-px bg-white/30 anim-line-draw mt-8" style="animation-delay: 0.3s;"></div>

      <!-- Subtitle -->
      <p class="mt-8 text-lg md:text-xl text-white/60 text-center max-w-xl tracking-wide animate-fade-in" style="animation-delay: 1.8s; animation-duration: 1s; opacity: 0; animation-fill-mode: forwards;">
        在代码与美学之间寻找平衡
      </p>

      <!-- Scroll indicator -->
      <button
        class="absolute bottom-12 text-white/40 hover:text-white/70 transition-colors duration-250 animate-fade-in"
        style="animation-delay: 2.4s; animation-duration: 1s; opacity: 0; animation-fill-mode: forwards;"
        aria-label="向下滚动"
        onclick="document.getElementById('recent-posts')?.scrollIntoView({ behavior: 'smooth' })"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce-soft">
          <path d="M12 5v14M19 12l-7 7-7-7"/>
        </svg>
      </button>
    </div>
  </section>

  <!-- ===== MAIN CONTENT with scroll animations ===== -->
  
    <!-- Recent Posts Section -->
    <section id="recent-posts" class="mx-auto max-w-6xl px-6 py-28">
      <div class="section-intro mb-16" data-observe>
        <p class="section-en-title text-5xl md:text-7xl font-bold tracking-tight text-primary/10 select-none">LATEST ARTICLES</p>
        <div class="section-cn-title mt-[-0.8em]">
          <h2 class="text-3xl font-semibold text-text-main">最新文章</h2>
          <p class="mt-2 text-sm text-text-sub">近期更新的技术笔记与思考</p>
        </div>
      </div>

      <div class="flex flex-col lg:flex-row gap-10">
        <!-- Left: Cards -->
        <div class="flex-1 min-w-0">
          {recentPosts.length > 0 ? (
            <div class="stagger-children grid grid-cols-1 sm:grid-cols-2 gap-5" data-observe>
              {recentPosts.map((post) => <BlogCard post={post} />)}
            </div>
          ) : (
            <div class="rounded-default bg-secondary/40 p-12 shadow-soft border border-primary/5 text-center reveal" data-observe>
              <p class="text-sm text-text-sub/50">暂无文章，敬请期待</p>
            </div>
          )}

          {sortedPosts.length > 4 && (
            <div class="mt-10 text-center reveal" data-observe>
              <a href="/blog" class="inline-flex items-center gap-2 rounded-default bg-primary/10 px-6 py-3 text-sm font-medium text-primary hover:bg-primary/20 transition-all duration-250">
                查看全部文章
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          )}
        </div>

        <!-- Right sidebar -->
        <aside class="w-full lg:w-80 shrink-0 space-y-6">
          <!-- Profile -->
          <div class="rounded-default bg-secondary/40 p-6 shadow-soft border border-primary/5 reveal" data-observe style="transition-delay: 200ms;">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 shrink-0 rounded-full bg-gradient-to-br from-primary/30 via-secondary to-accent-pink/30 flex items-center justify-center text-2xl font-bold text-primary shadow-soft">M</div>
              <div class="min-w-0">
                <h3 class="font-semibold text-text-main">Morandi</h3>
                <p class="text-xs text-text-sub/60 mt-0.5">前端工程师 / 设计系统爱好者</p>
              </div>
            </div>
            <p class="mt-4 text-sm text-text-sub leading-relaxed">在代码与美学之间寻找平衡。专注于前端工程化、设计系统与深度思考。</p>
            <div class="mt-4 space-y-2.5">
              <a href="https://github.com/Jiong-161" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary/8 text-text-sub hover:text-primary hover:bg-primary/15 transition-all duration-200" aria-label="GitHub">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              </a>
            </div>
          </div>

          <!-- Links -->
          <div class="rounded-default bg-secondary/40 p-6 shadow-soft border border-primary/5 reveal" data-observe style="transition-delay: 400ms;">
            <h3 class="text-sm font-semibold text-text-main mb-4 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              友情链接
            </h3>
            <div class="flex flex-wrap gap-2">
              <a href="https://docs.astro.build" target="_blank" rel="noopener noreferrer" class="inline-block rounded-full px-3 py-1 text-xs font-medium bg-primary/8 text-text-sub/70 hover:bg-primary/15 hover:text-primary transition-all duration-200">Astro Docs</a>
              <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="inline-block rounded-full px-3 py-1 text-xs font-medium bg-primary/8 text-text-sub/70 hover:bg-primary/15 hover:text-primary transition-all duration-200">Tailwind CSS</a>
              <a href="https://netlify.com" target="_blank" rel="noopener noreferrer" class="inline-block rounded-full px-3 py-1 text-xs font-medium bg-primary/8 text-text-sub/70 hover:bg-primary/15 hover:text-primary transition-all duration-200">Netlify</a>
              <a href="https://github.com/Jiong-161" target="_blank" rel="noopener noreferrer" class="inline-block rounded-full px-3 py-1 text-xs font-medium bg-primary/8 text-text-sub/70 hover:bg-primary/15 hover:text-primary transition-all duration-200">GitHub</a>
            </div>
          </div>
        </aside>
      </div>
    </section>
  <!-- Footer spacer -->
  <div class="h-0"></div>
</Layout>

<script is:inline>
  (function() {
    "use strict";

    // Intersection Observer for scroll-triggered animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          // Don't unobserve - allow replay on re-entry? No, one-time is cleaner.
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: "0px 0px -40px 0px",
    });

    // Observe all elements with data-observe
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll("[data-observe]").forEach((el) => {
        observer.observe(el);
      });
    });

    // Optional: subtle parallax on hero
    window.addEventListener("scroll", () => {
      const hero = document.querySelector(".relative.h-screen");
      if (!hero) return;
      const scrolled = window.scrollY;
      const bg = hero.querySelector(".anim-hero-zoom");
      if (bg && scrolled < window.innerHeight) {
        bg.style.transform = "translateY(" + (scrolled * 0.15) + "px) scale(1.08)";
      }
    }, { passive: true });
  })();
</script>
