---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: any };
const { post } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;
---

<Layout title={data.title} description={data.description}>
  <div class="mx-auto max-w-6xl px-6 pt-28 pb-24">
    <!-- 文章头部玻璃卡片 -->
    <div class="glass-card rounded-lg p-8 mb-8">
      <div class="max-w-3xl mx-auto lg:ml-[33%]">
        <div class="flex items-center gap-3 text-sm text-text-sub/60 mb-4">
          <span
            class="inline-block rounded-full px-3 py-0.5 text-xs font-medium tracking-wide bg-white/50"
            class:list={{
              'text-accent-green': data.category === '前端',
              'text-primary': data.category === '设计系统',
              'text-accent-pink': data.category === '工程化',
              'text-amber-700': data.category === '随笔',
              'text-indigo-600': data.category === '开源',
            }}
          >
            {data.category}
          </span>
          <time>{formatDate(data.pubDate)}</time>
          {data.updatedDate && (
            <span class="text-text-sub/40">· 更新于 {formatDate(data.updatedDate)}</span>
          )}
        </div>
        <h1 class="text-3xl md:text-4xl font-semibold text-text-main tracking-tight leading-snug">
          {data.title}
        </h1>
        <p class="mt-4 text-lg text-text-sub leading-relaxed">{data.description}</p>
        {data.tags && data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-5">
            {data.tags.map((tag: string) => (
              <span class="text-xs text-text-sub/60 bg-white/40 px-3 py-1 rounded-full">#{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="flex gap-10 relative">
      <!-- TOC 侧边栏 - 玻璃质感 -->
      <aside class="hidden lg:block w-[25%] shrink-0">
        <div class="glass-card rounded-lg p-4 sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-text-sub/50 mb-4 px-2">目录</h3>
          {headings && headings.length > 0 ? (
            <ul class="toc-list space-y-1 text-sm">
              {
                headings
                  .filter((h: any) => h.depth <= 3)
                  .map((h: any) => (
                    <li>
                      <a
                        href={'#' + h.slug}
                        data-toc-slug={h.slug}
                        class="toc-link block py-1.5 px-2 rounded-md text-text-sub/60 hover:text-primary hover:bg-white/30 transition-all duration-200 leading-relaxed"
                        style={{ paddingLeft: (h.depth - 1) * 12 + 8 + 'px' }}
                      >
                        {h.text}
                      </a>
                    </li>
                  ))
              }
            </ul>
          ) : null}
        </div>
      </aside>

      <!-- 正文区域 - 玻璃卡片包裹，内部纯净阅读 -->
      <article class="flex-1 min-w-0 prose-container max-w-3xl glass-card rounded-lg p-8 md:p-10">
        <Content />
      </article>
    </div>

    <!-- 返回按钮 -->
    <div class="mt-8 flex justify-center">
      <a
        href="/blog"
        class="inline-flex items-center gap-1.5 text-sm glass-card rounded-lg px-5 py-2.5 text-text-sub hover:text-primary transition-all duration-250"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        返回博客列表
      </a>
    </div>
  </div>
</Layout>

<style is:global>
  .prose-container {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-main);
  }
  .prose-container h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2.5em;
    margin-bottom: 0.8em;
    padding-bottom: 0.3em;
    border-bottom: 1px solid rgba(138, 161, 177, 0.12);
    color: var(--color-text-main);
    scroll-margin-top: 6rem;
  }
  .prose-container h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 2em;
    margin-bottom: 0.6em;
    color: var(--color-text-main);
    scroll-margin-top: 6rem;
  }
  .prose-container p {
    margin-bottom: 1.2em;
  }
  .prose-container a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: rgba(138, 161, 177, 0.3);
    transition: color 0.25s, text-decoration-color 0.25s;
  }
  .prose-container a:hover {
    color: var(--color-accent-pink);
    text-decoration-color: var(--color-accent-pink);
  }
  .prose-container ul, .prose-container ol {
    margin-bottom: 1.2em;
    padding-left: 1.5em;
  }
  .prose-container li { margin-bottom: 0.4em; }
  .prose-container ul li::marker { color: var(--color-primary); }
  .prose-container blockquote {
    border-left: 3px solid var(--color-primary);
    padding-left: 1em;
    margin: 1.5em 0;
    color: var(--color-text-sub);
    font-style: italic;
    background: rgba(138, 161, 177, 0.06);
    padding: 1em 1.2em;
    border-radius: 0 8px 8px 0;
  }
  .prose-container blockquote p:last-child { margin-bottom: 0; }
  .prose-container strong { font-weight: 600; color: var(--color-text-main); }
  .prose-container hr {
    border: none;
    border-top: 1px solid rgba(138, 161, 177, 0.12);
    margin: 2.5em 0;
  }
  .prose-container img { border-radius: 12px; margin: 1.5em 0; max-width: 100%; }
  .prose-container table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
    font-size: 0.9rem;
  }
  .prose-container th, .prose-container td {
    padding: 0.6em 1em;
    border: 1px solid rgba(138, 161, 177, 0.15);
    text-align: left;
  }
  .prose-container th { background: rgba(138, 161, 177, 0.08); font-weight: 600; }
  .prose-container code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.85em;
    background: rgba(138, 161, 177, 0.1);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }
  .prose-container pre {
    background: #2d2d2d;
    border-radius: 12px;
    padding: 1.2em 1.5em;
    overflow-x: auto;
    margin: 1.5em 0;
    position: relative;
  }
  .prose-container pre code {
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: 0.85rem;
    line-height: 1.7;
    color: #e0e0e0;
  }

  /* TOC ScrollSpy */
  .toc-link.toc-active {
    color: var(--color-primary);
    font-weight: 500;
    background: rgba(255, 255, 255, 0.4);
  }
</style>

<script>
  // Code block copy button
  document.querySelectorAll('.prose-container pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.className = 'absolute top-3 right-3 p-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white/60 hover:text-white transition-all duration-200';
    btn.setAttribute('aria-label', '复制代码');
    btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
    pre.classList.add('group');
    pre.style.position = 'relative';
    pre.appendChild(btn);

    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
        setTimeout(() => {
          btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
        }, 2000);
      } catch {}
    });
  });

  // TOC ScrollSpy - 使用 IntersectionObserver 优化性能
  const tocLinks = document.querySelectorAll('.toc-link');
  if (tocLinks.length > 0) {
    const headings = Array.from(tocLinks).map((link) => {
      const slug = link.getAttribute('data-toc-slug');
      return document.getElementById(slug);
    }).filter(Boolean);

    let activeIndex = -1;

    const observer = new IntersectionObserver((entries) => {
      let newActiveIndex = -1;
      entries.forEach((entry) => {
        const idx = headings.indexOf(entry.target);
        if (entry.isIntersecting && entry.boundingClientRect.top <= 150) {
          if (idx > newActiveIndex) {
            newActiveIndex = idx;
          }
        }
      });

      if (newActiveIndex === -1) {
        for (let i = headings.length - 1; i >= 0; i--) {
          if (headings[i].getBoundingClientRect().top < 150) {
            newActiveIndex = i;
            break;
          }
        }
      }

      if (newActiveIndex !== activeIndex) {
        activeIndex = newActiveIndex;
        tocLinks.forEach((link, i) => {
          link.classList.toggle('toc-active', i === activeIndex);
        });
      }
    }, {
      rootMargin: '-120px 0px -60% 0px',
      threshold: [0, 0.25, 0.5, 0.75, 1]
    });

    headings.forEach((h) => observer.observe(h));
  }
</script>
