---
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getCollection } from "astro:content";
import { getCategories } from "../../lib/utils";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);
const categories = getCategories(allPosts);

const activeCategory = Astro.url.searchParams.get("category");
const filteredPosts = activeCategory
  ? sortedPosts.filter((p) => p.data.category === activeCategory)
  : sortedPosts;
---

<Layout title="博客" description="Morandi Tech Blog 的所有文章">
  <div class="mx-auto max-w-6xl px-6 pt-28 pb-24">
    <!-- 页头 -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-text-main tracking-tight">博客</h1>
      <p class="mt-2 text-text-sub">
        {activeCategory ? (
          <>“{activeCategory}” 分类下共; {filteredPosts.length} 篇文章</>
        ) : (
          <>共; {allPosts.length} 篇文章</>
        )}
      </p>
    </div>

    <!-- 移动端分类筛选栏（水平滚动芯片） -->
    <div class="lg:hidden mb-6 overflow-x-auto scrollbar-none -mx-6 px-6">
      <div class="flex gap-2 whitespace-nowrap pb-2">
        <a
          href="/blog"
          class="inline-block rounded-full px-4 py-1.5 text-sm font-medium transition-all duration-200 shrink-0"
          class:list={{
            "bg-primary/15 text-primary font-semibold": !activeCategory,
            "bg-primary/5 text-text-sub hover:bg-primary/10 hover:text-primary": activeCategory,
          }}
        >
          全部
        </a>
        {categories.map((cat) => (
          <a
            href={`/blog?category=${encodeURIComponent(cat.name)}`}
            class="inline-block rounded-full px-4 py-1.5 text-sm font-medium transition-all duration-200 shrink-0"
            class:list={{
              "bg-accent-green/15 text-accent-green font-semibold": activeCategory === cat.name && cat.name === "设计系统",
              "bg-primary/15 text-primary font-semibold": activeCategory === cat.name && cat.name !== "设计系统",
              "bg-primary/5 text-text-sub hover:bg-primary/10 hover:text-primary": activeCategory && activeCategory !== cat.name,
              "bg-primary/5 text-text-sub hover:bg-primary/10 hover:text-primary": !activeCategory,
            }}
          >
            {cat.name}
            <span class="ml-1 text-xs opacity-60">{cat.count}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="flex gap-8">
      <!-- 左侧分类栏（桌面） -->
      <aside class="hidden lg:block w-56 shrink-0">
        <nav class="sticky top-28 space-y-1">
          <a
            href="/blog"
            class="block rounded-default px-4 py-2 text-sm font-medium transition-all duration-200"
            class:list={{
              "bg-primary/10 text-primary": !activeCategory,
              "text-text-sub hover:text-primary hover:bg-primary/5": activeCategory,
            }}
          >
            全部文章
          </a>
          {categories.map((cat) => {
            const catColors: Record<string, string> = {
              "前端": "hover:bg-accent-green/10 hover:text-accent-green",
              "设计系统": "hover:bg-primary/10 hover:text-primary",
              "工程化": "hover:bg-accent-pink/10 hover:text-accent-pink",
              "随笔": "hover:bg-amber-200/20 hover:text-amber-700",
              "开源": "hover:bg-indigo-200/20 hover:text-indigo-600",
            };
            const activeColors: Record<string, string> = {
              "前端": "bg-accent-green/15 text-accent-green",
              "设计系统": "bg-primary/15 text-primary",
              "工程化": "bg-accent-pink/15 text-accent-pink",
              "随笔": "bg-amber-200/30 text-amber-700",
              "开源": "bg-indigo-200/30 text-indigo-600",
            };
            return (
              <a
                href={`/blog?category=${encodeURIComponent(cat.name)}`}
                class="block rounded-default px-4 py-2 text-sm font-medium transition-all duration-200 flex items-center justify-between"
                class:list={{
                  [activeColors[cat.name] || "bg-primary/10 text-primary"]: activeCategory === cat.name,
                  [catColors[cat.name] || "text-text-sub hover:bg-primary/5 hover:text-primary"]: activeCategory !== cat.name,
                }}
              >
                <span>{cat.name}</span>
                <span class="text-xs opacity-50">{cat.count}</span>
              </a>
            );
          })}
        </nav>
      </aside>

      <!-- 右侧文章卡片流 -->
      <div class="flex-1 min-w-0">
        {filteredPosts.length > 0 ? (
          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {filteredPosts.map((post) => <BlogCard post={post} />)}
          </div>
        ) : (
          <div class="text-center py-24 text-text-sub/50">
            <p>该分类下暂无文章</p>
            <a href="/blog" class="text-primary hover:text-accent-pink transition-colors duration-250 mt-2 inline-block">
              查看全部文章 →;
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
