---
// 设置面板组件 - 侧边抽屉式
---

<!-- 设置面板遮罩 -->
<div id="settings-overlay" class="fixed inset-0 bg-black/20 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300"></div>

<!-- 设置面板抽屉 -->
<aside id="settings-panel" class="fixed top-0 right-0 h-full w-72 glass-card border-l border-white/30 z-50 transform translate-x-full transition-transform duration-300 ease-out overflow-y-auto">
  <div class="p-5">
    <!-- 标题 -->
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-base font-semibold text-text-main">主题设置</h3>
      <button id="settings-close" class="w-8 h-8 flex items-center justify-center rounded-lg text-text-sub hover:text-text-main hover:bg-white/30 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <!-- 壁纸模式 -->
    <div class="mb-6">
      <h4 class="text-sm font-medium text-text-main mb-3 flex items-center gap-2">
        <span class="w-1 h-4 rounded-full bg-primary"></span>
        壁纸模式
      </h4>
      <div class="grid grid-cols-2 gap-2">
        <button data-wallpaper="banner" class="wallpaper-mode-btn px-3 py-2.5 rounded-lg text-xs font-medium bg-white/40 text-primary border border-white/50 transition-all">
          横幅壁纸
        </button>
        <button data-wallpaper="fullscreen" class="wallpaper-mode-btn px-3 py-2.5 rounded-lg text-xs font-medium text-text-sub hover:bg-white/30 transition-all">
          全屏壁纸
        </button>
        <button data-wallpaper="transparent" class="wallpaper-mode-btn px-3 py-2.5 rounded-lg text-xs font-medium text-text-sub hover:bg-white/30 transition-all">
          全屏透明
        </button>
        <button data-wallpaper="solid" class="wallpaper-mode-btn px-3 py-2.5 rounded-lg text-xs font-medium text-text-sub hover:bg-white/30 transition-all">
          纯色背景
        </button>
      </div>
    </div>

    <!-- 壁纸设置 -->
    <div class="mb-6">
      <h4 class="text-sm font-medium text-text-main mb-3 flex items-center gap-2">
        <span class="w-1 h-4 rounded-full bg-accent-green"></span>
        壁纸设置
        <button id="refresh-wallpaper" class="ml-auto text-text-sub hover:text-primary transition-colors" title="刷新壁纸">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
        </button>
      </h4>
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs text-text-sub">首页壁纸标题</span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="setting-wallpaper-title" class="sr-only peer" checked>
            <div class="w-9 h-5 bg-white/30 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary/60"></div>
          </label>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-xs text-text-sub">壁纸轮播</span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="setting-carousel" class="sr-only peer">
            <div class="w-9 h-5 bg-white/30 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary/60"></div>
          </label>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-xs text-text-sub">水波纹动画</span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="setting-ripple" class="sr-only peer" checked>
            <div class="w-9 h-5 bg-white/30 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary/60"></div>
          </label>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-xs text-text-sub">渐变过渡</span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="setting-gradient" class="sr-only peer" checked>
            <div class="w-9 h-5 bg-white/30 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary/60"></div>
          </label>
        </div>
      </div>
    </div>

    <!-- 特效设置 -->
    <div class="mb-6">
      <h4 class="text-sm font-medium text-text-main mb-3 flex items-center gap-2">
        <span class="w-1 h-4 rounded-full bg-accent-pink"></span>
        特效设置
      </h4>
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs text-text-sub">樱花特效</span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="setting-sakura" class="sr-only peer">
            <div class="w-9 h-5 bg-white/30 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary/60"></div>
          </label>
        </div>
      </div>
    </div>

    <!-- 文章布局 -->
    <div class="mb-6">
      <h4 class="text-sm font-medium text-text-main mb-3 flex items-center gap-2">
        <span class="w-1 h-4 rounded-full bg-primary"></span>
        文章布局
      </h4>
      <div class="grid grid-cols-2 gap-2">
        <button data-layout="list" class="layout-mode-btn px-3 py-2.5 rounded-lg text-xs font-medium bg-white/40 text-primary border border-white/50 transition-all flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
          列表
        </button>
        <button data-layout="grid" class="layout-mode-btn px-3 py-2.5 rounded-lg text-xs font-medium text-text-sub hover:bg-white/30 transition-all flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
          网格
        </button>
      </div>
    </div>

    <!-- 重置按钮 -->
    <button id="settings-reset" class="w-full py-2 rounded-lg text-xs text-text-sub hover:text-primary hover:bg-white/30 transition-all mt-4">
      恢复默认设置
    </button>
  </div>
</aside>

<script>
  // ===== 设置管理 =====
  const DEFAULT_SETTINGS = {
    wallpaperMode: 'banner',
    wallpaperTitle: true,
    wallpaperCarousel: false,
    waterRipple: true,
    gradientTransition: true,
    sakuraEffect: false,
    postLayout: 'list',
    currentWallpaper: 0,
  };

  function loadSettings() {
    try {
      const saved = localStorage.getItem('blog-settings');
      return { ...DEFAULT_SETTINGS, ...(saved ? JSON.parse(saved) : {}) };
    } catch {
      return { ...DEFAULT_SETTINGS };
    }
  }

  function saveSettings(settings) {
    localStorage.setItem('blog-settings', JSON.stringify(settings));
  }

  let settings = loadSettings();

  // ===== 面板开关 =====
  const toggleBtn = document.getElementById('settings-toggle');
  const closeBtn = document.getElementById('settings-close');
  const panel = document.getElementById('settings-panel');
  const overlay = document.getElementById('settings-overlay');

  function openPanel() {
    panel.classList.remove('translate-x-full');
    overlay.classList.remove('opacity-0', 'pointer-events-none');
  }
  function closePanel() {
    panel.classList.add('translate-x-full');
    overlay.classList.add('opacity-0', 'pointer-events-none');
  }

  toggleBtn?.addEventListener('click', openPanel);
  closeBtn?.addEventListener('click', closePanel);
  overlay?.addEventListener('click', closePanel);

  // ===== 壁纸模式切换 =====
  const wallpaperBtns = document.querySelectorAll('.wallpaper-mode-btn');
  function updateWallpaperModeUI() {
    wallpaperBtns.forEach(btn => {
      const mode = btn.dataset.wallpaper;
      if (mode === settings.wallpaperMode) {
        btn.classList.add('bg-white/40', 'text-primary', 'border', 'border-white/50');
        btn.classList.remove('text-text-sub', 'hover:bg-white/30');
      } else {
        btn.classList.remove('bg-white/40', 'text-primary', 'border', 'border-white/50');
        btn.classList.add('text-text-sub', 'hover:bg-white/30');
      }
    });
    document.documentElement.setAttribute('data-wallpaper', settings.wallpaperMode);
  }
  wallpaperBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      settings.wallpaperMode = btn.dataset.wallpaper;
      saveSettings(settings);
      updateWallpaperModeUI();
      applyWallpaper();
    });
  });

  // ===== 开关设置 =====
  const switches = [
    { id: 'setting-wallpaper-title', key: 'wallpaperTitle' },
    { id: 'setting-carousel', key: 'wallpaperCarousel' },
    { id: 'setting-ripple', key: 'waterRipple' },
    { id: 'setting-gradient', key: 'gradientTransition' },
    { id: 'setting-sakura', key: 'sakuraEffect' },
  ];

  switches.forEach(({ id, key }) => {
    const el = document.getElementById(id);
    if (!el) return;
    el.checked = settings[key];
    el.addEventListener('change', () => {
      settings[key] = el.checked;
      saveSettings(settings);
      applyEffect(key, el.checked);
    });
  });

  // ===== 布局切换 =====
  const layoutBtns = document.querySelectorAll('.layout-mode-btn');
  function updateLayoutUI() {
    layoutBtns.forEach(btn => {
      const layout = btn.dataset.layout;
      if (layout === settings.postLayout) {
        btn.classList.add('bg-white/40', 'text-primary', 'border', 'border-white/50');
        btn.classList.remove('text-text-sub', 'hover:bg-white/30');
      } else {
        btn.classList.remove('bg-white/40', 'text-primary', 'border', 'border-white/50');
        btn.classList.add('text-text-sub', 'hover:bg-white/30');
      }
    });
    document.documentElement.setAttribute('data-post-layout', settings.postLayout);
  }
  layoutBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      settings.postLayout = btn.dataset.layout;
      saveSettings(settings);
      updateLayoutUI();
    });
  });

  // ===== 刷新壁纸 =====
  document.getElementById('refresh-wallpaper')?.addEventListener('click', () => {
    settings.currentWallpaper = (settings.currentWallpaper + 1) % 3;
    saveSettings(settings);
    applyWallpaper();
  });

  // ===== 重置 =====
  document.getElementById('settings-reset')?.addEventListener('click', () => {
    settings = { ...DEFAULT_SETTINGS };
    saveSettings(settings);
    updateWallpaperModeUI();
    updateLayoutUI();
    switches.forEach(({ id, key }) => {
      const el = document.getElementById(id);
      if (el) el.checked = settings[key];
    });
    applyAllSettings();
  });

  // ===== 应用效果的占位函数（实际逻辑在各特效组件中） =====
  function applyEffect(key, enabled) {
    // 通过自定义事件通知各组件
    document.dispatchEvent(new CustomEvent('setting-change', { detail: { key, enabled } }));
  }

  function applyWallpaper() {
    document.dispatchEvent(new CustomEvent('wallpaper-change', { detail: settings }));
  }

  function applyAllSettings() {
    applyWallpaper();
    switches.forEach(({ key }) => {
      applyEffect(key, settings[key]);
    });
  }

  // ===== 初始化 =====
  updateWallpaperModeUI();
  updateLayoutUI();

  // 导出给其他脚本用
  window.__blogSettings = settings;
  window.__loadSettings = loadSettings;
</script>
