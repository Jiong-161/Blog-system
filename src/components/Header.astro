---
const navItems = [
  { label: '首页', href: '/' },
  { label: '博客', href: '/blog' },
  { label: '归档', href: '/archive' },
  { label: '关于', href: '/about' },
  { label: '留言', href: '/guestbook' },
  { label: '统计', href: '/stats' },
];
const currentPath = Astro.url.pathname;
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-400">
  <div class="glass border-b border-white/20">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <!-- Logo -->
      <a href="/" class="text-xl font-semibold tracking-tight text-text-main hover:text-primary transition-colors duration-250">
        Morandi<span class="text-text-sub font-light">Tech</span>
      </a>

      <!-- 桌面端导航 -->
      <div class="hidden md:flex items-center gap-1">
        <ul class="flex items-center gap-1">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-lg px-4 py-2 text-sm font-medium transition-all duration-250"
                class:list={{
                  'text-primary bg-white/40': currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)),
                  'text-text-sub hover:text-text-main hover:bg-white/30': !(currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))),
                }}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <!-- 设置按钮 -->
        <button id="music-toggle" class="ml-3 h-8 flex items-center px-3 rounded-lg text-text-sub hover:text-text-main hover:bg-white/30 transition-all duration-200" aria-label="音乐">
          <svg id="music-icon-off" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
          <svg id="music-icon-on" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/><path d="M9 18c0-3 2-4 4-4s4 1 4 4"/><path d="M6 18c0-3 1.5-5 3.5-5"/></svg>
        </button>
        <button id="settings-toggle" class="h-8 flex items-center px-3 rounded-lg text-text-sub hover:text-text-main hover:bg-white/30 transition-all duration-200" aria-label="设置">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
      </div>

      <!-- 移动端：音乐 + 设置 + 菜单 -->
      <div class="flex items-center gap-1 md:hidden">
        <button id="music-toggle-mobile" class="p-2 text-text-sub hover:text-text-main transition-colors duration-250" aria-label="音乐">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        </button>
        <button id="settings-toggle-mobile" class="p-2 text-text-sub hover:text-text-main transition-colors duration-250" aria-label="设置">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
        <button id="menu-toggle" class="p-2 text-text-sub hover:text-text-main transition-colors duration-250" aria-label="菜单">
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- 移动端菜单面板 -->
  <div id="mobile-menu" class="hidden md:hidden glass border-t border-white/20">
    <ul class="flex flex-col px-6 py-4 space-y-1">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="block rounded-lg px-4 py-3 text-base font-medium transition-all duration-200"
            class:list={{
              'text-primary bg-white/40': currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)),
              'text-text-sub hover:text-text-main hover:bg-white/30': !(currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))),
            }}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');
  let isScrolled = false;
  let menuOpen = false;

  // ===== 背景音乐 =====
  const musicBtn = document.getElementById('music-toggle');
  const musicBtnMobile = document.getElementById('music-toggle-mobile');
  const musicIconOff = document.getElementById('music-icon-off');
  const musicIconOn = document.getElementById('music-icon-on');

  let audio: HTMLAudioElement | null = null;
  let isPlaying = false;

  function initAudio() {
    if (audio) return;
    audio = new Audio('/mp3/%E6%96%B9%E5%A4%A7%E5%90%8C%20-%20%E7%89%B9%E5%88%AB%E7%9A%84%E4%BA%BA.mp3');
    audio.loop = true;
    audio.volume = 0.5;
  }

  function updateMusicIcon() {
    if (musicIconOff && musicIconOn) {
      musicIconOff.classList.toggle('hidden', isPlaying);
      musicIconOn.classList.toggle('hidden', !isPlaying);
    }
    if (musicBtn) {
      musicBtn.classList.toggle('text-primary', isPlaying);
      musicBtn.classList.toggle('text-text-sub', !isPlaying);
    }
    if (musicBtnMobile) {
      musicBtnMobile.classList.toggle('text-primary', isPlaying);
      musicBtnMobile.classList.toggle('text-text-sub', !isPlaying);
    }
  }

  function toggleMusic() {
    initAudio();
    if (!audio) return;

    if (isPlaying) {
      audio.pause();
      isPlaying = false;
    } else {
      audio.play().catch(() => {
        // 自动播放被阻止，用户需要再次点击
      });
      isPlaying = true;
    }
    updateMusicIcon();
    try {
      localStorage.setItem('bgm-playing', isPlaying ? '1' : '0');
    } catch (e) {}
  }

  musicBtn?.addEventListener('click', toggleMusic);
  musicBtnMobile?.addEventListener('click', toggleMusic);

  // 恢复播放状态
  try {
    const saved = localStorage.getItem('bgm-playing');
    if (saved === '1') {
      // 尝试恢复播放（可能被浏览器自动播放策略阻止）
      initAudio();
      const tryPlay = () => {
        audio?.play().then(() => {
          isPlaying = true;
          updateMusicIcon();
        }).catch(() => {});
        document.removeEventListener('click', tryPlay);
      };
      // 先尝试自动播放，失败则等用户首次点击时播放
      audio?.play().then(() => {
        isPlaying = true;
        updateMusicIcon();
      }).catch(() => {
        document.addEventListener('click', tryPlay, { once: true });
      });
    }
  } catch (e) {}

  // 移动端设置按钮同步
  const mobileSettingsBtn = document.getElementById('settings-toggle-mobile');
  mobileSettingsBtn?.addEventListener('click', () => {
    document.getElementById('settings-toggle')?.click();
  });

  // 滚动时增强阴影和模糊
  const updateHeader = () => {
    const shouldBeScrolled = window.scrollY > 20;
    if (shouldBeScrolled !== isScrolled) {
      isScrolled = shouldBeScrolled;
      const glassBar = header.querySelector('.glass');
      if (glassBar) {
        if (isScrolled) {
          glassBar.style.boxShadow = '0 8px 32px rgba(60, 55, 50, 0.08)';
          glassBar.style.backdropFilter = 'blur(24px)';
        } else {
          glassBar.style.boxShadow = '';
          glassBar.style.backdropFilter = '';
        }
      }
    }
  };
  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  // 移动端菜单切换
  if (toggle && mobileMenu) {
    toggle.addEventListener('click', () => {
      menuOpen = !menuOpen;
      mobileMenu.classList.toggle('hidden', !menuOpen);
      openIcon?.classList.toggle('hidden', menuOpen);
      closeIcon?.classList.toggle('hidden', !menuOpen);
    });

    // 点击菜单项后关闭
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menuOpen = false;
        mobileMenu.classList.add('hidden');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      });
    });

    // 点击菜单外部关闭
    document.addEventListener('click', (e) => {
      if (menuOpen && !header?.contains(e.target as Node)) {
        menuOpen = false;
        mobileMenu.classList.add('hidden');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    });
  }
</script>